{
  "name": "catuwu",
  "displayName": "catUwU",
  "description": "Project in wich i'll vibe code until a problem occurs and i'll give up",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "catUwU",
      "properties": {
        "catuwu.eyeColor": { "type": "string", "default": "#22B14C", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Colour substituted for the eye mask in open-eye frames." },
        "catuwu.eyelidColor": { "type": "string", "default": "#000000", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Colour substituted for the eye mask in eyelid frames." },
        "catuwu.maskColor": { "type": "string", "default": "#22B14C", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Exact sprite mask colour to replace. New sprite eye and eyelid pixels should use this colour." }
      }
    },
    "commands": [
      {
        "command": "catuwu.summon",
        "title": "catUwU: Summon"
      },
      {
        "command": "catuwu.action",
        "title": "catUwU: Choose Action"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
